{
  "goal": "Create a multi-agent AI research company that receives a business question, researches the topic using multiple sources, verifies and compares the evidence, performs financial and market analysis, identifies risks and uncertainties, writes an executive report, and has a final reviewer validate the report before delivery.",
  "members": [
    {
      "name": "researcher",
      "role": "research",
      "purpose": "Research the business question using multiple relevant sources.",
      "inputs": [
        "business_question"
      ],
      "outputs": [
        "research_evidence"
      ]
    },
    {
      "name": "verifier",
      "role": "verification",
      "purpose": "Verify, compare, and qualify the research evidence.",
      "inputs": [
        "research_evidence"
      ],
      "outputs": [
        "verified_evidence"
      ]
    },
    {
      "name": "market_analyst",
      "role": "financial and market analysis",
      "purpose": "Perform financial and market analysis from verified evidence.",
      "inputs": [
        "verified_evidence"
      ],
      "outputs": [
        "market_analysis"
      ]
    },
    {
      "name": "risk_analyst",
      "role": "risk analysis",
      "purpose": "Identify material risks, uncertainties, assumptions, and missing evidence.",
      "inputs": [
        "verified_evidence",
        "market_analysis"
      ],
      "outputs": [
        "risk_assessment"
      ]
    },
    {
      "name": "writer",
      "role": "executive writer",
      "purpose": "Produce a clear executive report from the team's evidence and analysis.",
      "inputs": [
        "verified_evidence",
        "market_analysis",
        "risk_assessment"
      ],
      "outputs": [
        "executive_report"
      ]
    },
    {
      "name": "reviewer",
      "role": "final reviewer",
      "purpose": "Validate the final report against evidence, analysis, risks, and acceptance criteria.",
      "inputs": [
        "executive_report",
        "risk_assessment"
      ],
      "outputs": [
        "reviewed_report"
      ]
    }
  ],
  "plan": [
    {
      "order": 1,
      "agent": "researcher",
      "role": "research",
      "inputs": [
        "business_question"
      ],
      "outputs": [
        "research_evidence"
      ],
      "missing_inputs": [
        "business_question"
      ]
    },
    {
      "order": 2,
      "agent": "verifier",
      "role": "verification",
      "inputs": [
        "research_evidence"
      ],
      "outputs": [
        "verified_evidence"
      ],
      "missing_inputs": []
    },
    {
      "order": 3,
      "agent": "market_analyst",
      "role": "financial and market analysis",
      "inputs": [
        "verified_evidence"
      ],
      "outputs": [
        "market_analysis"
      ],
      "missing_inputs": []
    },
    {
      "order": 4,
      "agent": "risk_analyst",
      "role": "risk analysis",
      "inputs": [
        "verified_evidence",
        "market_analysis"
      ],
      "outputs": [
        "risk_assessment"
      ],
      "missing_inputs": []
    },
    {
      "order": 5,
      "agent": "writer",
      "role": "executive writer",
      "inputs": [
        "verified_evidence",
        "market_analysis",
        "risk_assessment"
      ],
      "outputs": [
        "executive_report"
      ],
      "missing_inputs": []
    },
    {
      "order": 6,
      "agent": "reviewer",
      "role": "final reviewer",
      "inputs": [
        "executive_report",
        "risk_assessment"
      ],
      "outputs": [
        "reviewed_report"
      ],
      "missing_inputs": []
    }
  ],
  "validation": "passed",
  "entrypoint": "run.py"
}
